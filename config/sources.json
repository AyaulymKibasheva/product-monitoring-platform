{
  "organizations": [
    {
      "id": "demo-organization",
      "name": "Demonstration Organization",
      "active": true,
      "monitoring": {
        "minimum_price_change": 0,
        "minimum_price_change_percent": 0
      },
      "notification_channels": [
        {
          "id": "demo-email",
          "name": "Operations email",
          "type": "email",
          "recipient": "alerts@example.com",
          "active": false,
          "settings": {"host_env": "SMTP_HOST", "sender_env": "SMTP_FROM"}
        },
        {
          "id": "demo-slack",
          "name": "Operations Slack",
          "type": "slack",
          "active": false,
          "settings": {"webhook_env": "SLACK_WEBHOOK_URL"}
        }
      ],
      "notification_rules": [
        {
          "id": "demo-important-events",
          "name": "Important product and source events",
          "events": ["price_drop", "price_increase", "new_product", "back_in_stock", "out_of_stock", "product_missing", "source_failed", "data_quality_problem"],
          "channel_ids": ["demo-email", "demo-slack"],
          "minimum_price_change_percent": 5,
          "frequency": "immediate",
          "active": false
        }
      ]
    }
  ],
  "sources": [
    {
      "id": "books-demo",
      "organization_id": "demo-organization",
      "name": "Books to Scrape HTML Demo",
      "type": "html",
      "adapter": "books_demo",
      "base_url": "https://books.toscrape.com/",
      "default_currency": "GBP",
      "schedule": "0 */6 * * *",
      "timeout_seconds": 10,
      "max_retries": 3,
      "backoff_factor": 0.5,
      "active": true,
      "settings": {}
    },
    {
      "id": "steam-live",
      "organization_id": "demo-organization",
      "name": "Steam Store Live Prices",
      "type": "api",
      "adapter": "steam_store",
      "base_url": "https://store.steampowered.com/",
      "default_currency": "USD",
      "schedule": "10 */3 * * *",
      "timeout_seconds": 15,
      "max_retries": 3,
      "backoff_factor": 0.5,
      "requests_per_second": 2,
      "active": true,
      "settings": {
        "country_code": "us",
        "language": "en",
        "sections": ["specials", "top_sellers", "new_releases"]
      }
    },
    {
      "id": "bestbuy-live",
      "organization_id": "demo-organization",
      "name": "Best Buy Live Products API",
      "type": "api",
      "adapter": "bestbuy",
      "base_url": "https://api.bestbuy.com/v1/",
      "default_currency": "USD",
      "schedule": "20 */6 * * *",
      "timeout_seconds": 15,
      "max_retries": 3,
      "backoff_factor": 0.5,
      "requests_per_second": 2,
      "active": false,
      "settings": {"api_key_env": "BESTBUY_API_KEY", "page_size": 50}
    },
    {
      "id": "dummyjson-api",
      "organization_id": "demo-organization",
      "name": "DummyJSON REST API Demo",
      "type": "api",
      "adapter": "dummyjson",
      "base_url": "https://dummyjson.com/",
      "default_currency": "USD",
      "schedule": "15 */6 * * *",
      "timeout_seconds": 10,
      "max_retries": 3,
      "backoff_factor": 0.5,
      "active": true,
      "settings": {"page_size": 30}
    },
    {
      "id": "sandbox-js",
      "organization_id": "demo-organization",
      "name": "Scraping Sandbox JavaScript Demo",
      "type": "javascript",
      "adapter": "scraping_sandbox",
      "base_url": "https://scrapingsandbox.com/infinite-scroll",
      "default_currency": "USD",
      "schedule": "30 */12 * * *",
      "timeout_seconds": 30,
      "max_retries": 2,
      "backoff_factor": 0.5,
      "active": true,
      "settings": {"scroll_wait_ms": 3000, "headless": true}
    },
    {
      "id": "supplier-file-demo",
      "organization_id": "demo-organization",
      "name": "Supplier CSV File Demo",
      "type": "file",
      "adapter": "catalog_file",
      "default_currency": "USD",
      "schedule": "45 */12 * * *",
      "active": true,
      "settings": {
        "path": "examples/supplier_products.csv",
        "format": "csv",
        "page_size": 100,
        "attribute_fields": ["material", "weight"]
      }
    }
  ]
}
